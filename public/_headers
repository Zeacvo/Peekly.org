/*
  Content-Security-Policy: default-src 'self' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://challenges.cloudflare.com https://*.challenges.cloudflare.com https://*.cloudflarecaptcha.com https://accounts.google.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.cdnfonts.com; font-src 'self' https://fonts.gstatic.com https://fonts.cdnfonts.com data:; img-src 'self' data: blob: https:; connect-src 'self' data: https://challenges.cloudflare.com https://*.challenges.cloudflare.com https://*.cloudflarecaptcha.com https://*.dnstest.challenges.cloudflare.com https://dnstest.dev https://accounts.google.com https://oauth2.googleapis.com https://www.googleapis.com https://cloudflareinsights.com; frame-src 'self' https://challenges.cloudflare.com https://*.challenges.cloudflare.com https://*.cloudflarecaptcha.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self';
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/brand/bimi-logo.svg
  Content-Type: image/svg+xml
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=604800

/logo.svg
  Content-Type: image/svg+xml
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=604800

/favicon.svg
  Content-Type: image/svg+xml
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=604800
